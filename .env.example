# Copia este archivo como .env.local y completa los valores. NUNCA subas .env.local a git.
# Detalle de cada variable: ARCHITECTURE.md §13.9

# --- Supabase (obligatorio) · Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: solo el servidor (worker y cron). Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicación (obligatorio) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Santo_Domingo
DEFAULT_PROVINCE_CODE=SR
# Secretos aleatorios de 32+ caracteres (por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
CRON_SECRET=
JOBS_SECRET=

# --- Pendientes de vincular (opcionales hoy) ---
# Correo propio (Resend) · se configura en Supabase Auth → SMTP
RESEND_API_KEY=
# Notificaciones push (se generan con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:equipo@tudominio.com
# Errores (opcional): si existe, src/instrumentation.ts también envía los errores del servidor a Sentry.
# Sin esto, igual quedan en los registros de Vercel.
SENTRY_DSN=
