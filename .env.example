# Copia este archivo como .env.local y completa los valores. NUNCA subas .env.local a git.
# Detalle de cada variable: ARCHITECTURE.md §13.9

# --- Supabase (obligatorio) · Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: solo el servidor (worker y cron). Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicación (obligatorio) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_PROVINCE_CODE=SR
# La zona horaria (America/Santo_Domingo) es fija en src/utils/locale.ts: no hace falta variable.
# Secretos aleatorios de 32+ caracteres (por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
CRON_SECRET=
JOBS_SECRET=

# --- Pendientes de vincular (opcionales hoy) ---
# Captcha de /entrar (Cloudflare Turnstile): clave PÚBLICA del widget (Cloudflare → Turnstile → Site Key).
# Vacía = sin captcha, todo igual que antes. La clave SECRETA no va aquí: va en Supabase → Authentication →
# Attack Protection. Como es NEXT_PUBLIC_, se fija al construir: después de cambiarla hay que volver a desplegar.
# Para probar en local: 1x00000000000000000000AA (clave de prueba de Cloudflare que siempre aprueba).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Correo propio (Resend): la app no lee esta clave. Se pega en Supabase → Authentication → SMTP Settings.
# Aquí solo como recordatorio de dónde va.
# RESEND_API_KEY=
# Notificaciones push (se generan con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:equipo@tudominio.com
# Errores (opcional): si existe, src/instrumentation.ts también envía los errores del servidor a Sentry.
# Sin esto, igual quedan en los registros de Vercel.
SENTRY_DSN=

# --- Operación (solo en la computadora de quien mantiene la app; nunca en Vercel) ---
# "staging" o "production": los scripts que crean cuentas de prueba se niegan a correr si dice "prod".
SUPABASE_ENV=staging
# Frase para descifrar las copias diarias de backup.yml (npm run backup:check). Guardarla también en el
# gestor de contraseñas de la organización: sin ella, las copias no se pueden restaurar.
BACKUP_PASSPHRASE=
# Pruebas E2E: a qué dirección apuntan (por defecto http://localhost:3000) y carpeta opcional para capturas.
# E2E_BASE_URL=
# E2E_SCREENSHOTS=
