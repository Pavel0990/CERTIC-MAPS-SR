{
  "name": "sr-conecta",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Plataforma geográfica de la provincia Santiago Rodríguez (TechEmprende SR Conecta 2026)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:boundaries": "node --test tests/boundaries/boundaries.test.mjs",
    "test:db": "npm --prefix supabase/tests test",
    "test:e2e": "playwright test",
    "db:types": "npx supabase gen types typescript --linked --schema public > src/types/database.ts",
    "backup": "node --no-deprecation scripts/backup-snapshot.mjs",
    "backup:check": "node --no-deprecation scripts/restore-check.mjs",
    "db:audit": "node --no-deprecation scripts/db-audit.mjs",
    "data:osm": "node data/fetch-osm-routes.mjs && node data/import-osm-content.mjs",
    "data:lugares": "node --no-deprecation scripts/load-places-content.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:boundaries"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "handlebars": "4.7.10"
  }
}
