{
  "name": "sr-conecta",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma geográfica de la provincia Santiago Rodríguez (TechEmprende SR Conecta 2026)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:boundaries": "node --test tests/boundaries/boundaries.test.mjs",
    "test:db": "npm --prefix supabase/tests test",
    "check": "npm run lint && npm run typecheck && npm run test:boundaries"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
